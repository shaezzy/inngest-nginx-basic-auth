worker_processes 1;

events {
  worker_connections 1024;
}

http {
  server {
    listen ${PORT};
    server_name _;

    # API v1 – runs, events, apps, cancellations, signals, traces
    location /v1/ {
      auth_basic off;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

      proxy_pass ${PROXY_PASS};
    }

    # WebSocket realtime (more specific than /v1/, takes precedence for upgrade requests)
    location /v1/realtime/ {
      auth_basic off;

      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";

      proxy_set_header Host $host;
      proxy_read_timeout 620s;
      proxy_send_timeout 620s;
      proxy_pass ${PROXY_PASS};
    }

    # Dashboard status: authenticate the reader before adding server credentials.
    # Exact match keeps the signing key off /dev/traces and other API requests.
    location = /dev {
      auth_basic "Restricted";
      auth_basic_user_file /etc/nginx/.htpasswd;

      proxy_set_header Authorization "Bearer ${INNGEST_SIGNING_KEY}";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

      proxy_pass ${PROXY_PASS};
    }

    # Other dev API paths retain the caller's authentication.
    location /dev {
      auth_basic off;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

      proxy_pass ${PROXY_PASS};
    }

    # Event ingestion
    location /e/ {
      auth_basic off;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

      proxy_pass ${PROXY_PASS};
    }

    # Function registration / management (SDK sync)
    location /fn/ {
      auth_basic off;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

      proxy_pass ${PROXY_PASS};
    }

    # Health check
    location /health {
      auth_basic off;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

      proxy_pass ${PROXY_PASS};
    }

    # Function invocation
    location /invoke/ {
      auth_basic off;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

      proxy_pass ${PROXY_PASS};
    }

    # REST API v2
    location /api/ {
      auth_basic off;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

      proxy_pass ${PROXY_PASS};
    }

    # Core API v0
    location /v0/ {
      auth_basic off;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

      proxy_pass ${PROXY_PASS};
    }

    # Prometheus metrics
    location /metrics {
      auth_basic off;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

      proxy_pass ${PROXY_PASS};
    }

    # Dashboard – protected by basic auth
    location / {
        auth_basic	"Restricted";
        auth_basic_user_file	/etc/nginx/.htpasswd;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_set_header X-Nginx-Proxy true;
        proxy_http_version 1.1;
        proxy_pass ${PROXY_PASS};
    }
  }
}
